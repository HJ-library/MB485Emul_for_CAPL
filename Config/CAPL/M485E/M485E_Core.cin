/*
 * 함수명: M485E_Core_ReadRuleSnapshot
 * 기능: Device Index와 Rule ID의 현재 Register 묶음을 동기식으로 읽는다.
 * 파라미터:
 *   index - DeviceMap의 장치 Index
 *   ruleId - FrameRule의 Rule_ID
 *   outMeta - M485E_SM_* Layout의 호출자 소유 배열
 *   outRegisters - Rule Quantity를 받을 호출자 소유 word 배열
 * 반환값: M485E_OK 또는 Rule/출력 버퍼 오류 코드
 */
long M485E_Core_ReadRuleSnapshot(long index, long ruleId, long outMeta[],
     word outRegisters[])
{
     return M485E_Dll_ReadRuleSnapshot(gM485E_ContextHandle, index, ruleId,
          elcount(outMeta), outMeta,
          elcount(outRegisters), outRegisters);
}

/*
 * 함수명: M485E_Core_TryDequeueChangeSnapshot
 * 기능: 지정 Port의 값 변경 Snapshot Queue에서 한 건을 꺼낸다.
 * 파라미터:
 *   portSlot - 조회할 DLL Port Slot
 *   outMeta - M485E_SM_* Layout의 호출자 소유 배열
 *   outRegisters - Snapshot Register를 받을 호출자 소유 word 배열
 * 반환값: M485E_OK, M485E_STATUS_NO_DATA 또는 DLL 오류 코드
 */
long M485E_Core_TryDequeueChangeSnapshot(long portSlot, long outMeta[],
     word outRegisters[])
{
     return M485E_Dll_TryDequeueChangeSnapshot(gM485E_ContextHandle, portSlot,
          elcount(outMeta), outMeta,
          elcount(outRegisters), outRegisters);
}

/*
 * 함수명: M485E_Core_GetChangeQueueStats
 * 기능: 지정 Port의 Change Queue 사용량과 누락 통계를 조회한다.
 * 파라미터:
 *   portSlot - 조회할 DLL Port Slot
 *   outStats - M485E Change Queue 통계 Layout을 받을 배열
 * 반환값: M485E_OK 또는 Port/출력 버퍼 오류 코드
 */
long M485E_Core_GetChangeQueueStats(long portSlot, long outStats[])
{
     return M485E_Dll_GetChangeQueueStats(gM485E_ContextHandle, portSlot,
          elcount(outStats), outStats);
}

/*
 * 함수명: M485E_Core_ReadRegisters
 * 기능: Function Code 구분 없이 DLL Register 메모리의 연속 범위를 읽는다.
 * 파라미터:
 *   index - DeviceMap의 장치 Index
 *   startAddress - 첫 Register Address
 *   quantity - 읽을 16-bit Register 개수
 *   outRegisters - 결과를 받을 호출자 소유 word 배열
 * 반환값: M485E_OK 또는 주소/출력 버퍼 오류 코드
 */
long M485E_Core_ReadRegisters(long index, long startAddress, long quantity,
     word outRegisters[])
{
     return M485E_Dll_ReadRegisters(gM485E_ContextHandle, index, startAddress, quantity,
          elcount(outRegisters), outRegisters);
}

/*
 * 함수명: M485E_Core_WriteRegisters
 * 기능: 입력 word 배열의 연속 Register 값을 DLL 메모리에 적용한다.
 * 파라미터:
 *   index - DeviceMap의 장치 Index
 *   startAddress - 첫 Register Address
 *   quantity - 쓸 16-bit Register 개수
 *   inRegisters - 쓸 값을 보관한 word 배열
 * 반환값: M485E_OK 또는 주소/입력 버퍼 오류 코드
 */
long M485E_Core_WriteRegisters(long index, long startAddress, long quantity,
     word inRegisters[])
{
     return M485E_Dll_WriteRegisters(gM485E_ContextHandle, index, startAddress, quantity,
          elcount(inRegisters), inRegisters);
}

/*
 * 함수명: M485E_Core_ResetDevice
 * 기능: 지정 장치의 Register 메모리를 CSV Init_Value 상태로 되돌린다.
 * 파라미터: index - DeviceMap의 장치 Index
 * 반환값: M485E_OK 또는 장치 Index 오류 코드
 */
long M485E_Core_ResetDevice(long index)
{
     return M485E_Dll_ResetDevice(gM485E_ContextHandle, index);
}

/*
 * 함수명: M485E_Core_ReadSignal
 * 기능: 대소문자를 구분하는 SignalName으로 물리값을 읽는다.
 * 파라미터:
 *   index - DeviceMap의 장치 Index
 *   signalName - Register Map의 SignalName
 *   outPhysicalValue - 성공한 물리값을 받을 참조 변수
 * 반환값: M485E_OK 또는 Signal/변환 오류 코드
 */
long M485E_Core_ReadSignal(long index, char signalName[], float& outPhysicalValue)
{
     float abiOutValue[1];
     long result;
     abiOutValue[0] = outPhysicalValue;
     result = M485E_Dll_ReadSignal(gM485E_ContextHandle, index, strlen(signalName),
          signalName, abiOutValue);
     if (result == M485E_OK) outPhysicalValue = abiOutValue[0];
     return result;
}

/*
 * 함수명: M485E_Core_WriteSignal
 * 기능: SignalName의 Type/Scale/Offset 규칙에 따라 물리값을 Register에 쓴다.
 * 파라미터:
 *   index - DeviceMap의 장치 Index
 *   signalName - Register Map의 SignalName
 *   inPhysicalValue - 적용할 물리값
 * 반환값: M485E_OK 또는 Signal/범위/변환 오류 코드
 */
long M485E_Core_WriteSignal(long index, char signalName[], float inPhysicalValue)
{
     return M485E_Dll_WriteSignal(gM485E_ContextHandle, index, strlen(signalName), signalName,
          inPhysicalValue);
}

/*
 * 함수명: M485E_Core_GetLastSyncError
 * 기능: 가장 최근 동기 API 실패의 상세 메타데이터와 문자열을 조회한다.
 * 파라미터:
 *   outMeta - 오류 메타데이터를 받을 long 배열
 *   outText - 오류 설명을 받을 char 배열
 * 반환값: M485E_OK 또는 출력 버퍼 오류 코드
 */
long M485E_Core_GetLastSyncError(long outMeta[], char outText[])
{
     return M485E_Dll_GetLastSyncError(gM485E_ContextHandle, elcount(outMeta), outMeta,
          elcount(outText), outText);
}

/*
 * 함수명: M485E_Core_TryDequeueErrorEvent
 * 기능: 비동기 오류 Queue에서 이벤트 한 건을 꺼낸다.
 * 파라미터:
 *   outMeta - 오류 메타데이터를 받을 long 배열
 *   outText - 오류 설명을 받을 char 배열
 * 반환값: M485E_OK, M485E_STATUS_NO_DATA 또는 출력 버퍼 오류 코드
 */
long M485E_Core_TryDequeueErrorEvent(long outMeta[], char outText[])
{
     return M485E_Dll_TryDequeueErrorEvent(gM485E_ContextHandle, elcount(outMeta), outMeta,
          elcount(outText), outText);
}

/*
 * 함수명: M485E_Core_GetErrorQueueStats
 * 기능: 비동기 오류 Queue의 현재 사용량과 누락 통계를 조회한다.
