 */
long M485E_Core_Connect()
{
     return M485E_Dll_Connect(gM485E_ContextHandle);
}

/*
 * 함수명: M485E_Core_Disconnect
 * 기능: Serial Port와 통신 작업을 중지하되 DLL Context와 설정은 유지한다.
